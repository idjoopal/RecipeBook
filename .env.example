# =============================================================================
# 루트 .env.example — 글로벌(공통) 설정 전용 템플릿
# =============================================================================
# 복사해서 .env 로 만들어 사용하세요. 여기에는 모든 에이전트가 공유하는
# 인프라(서버 실행 + LLM 키/엔드포인트)만 둡니다.
# 에이전트 전용 키는 src/agents/agent_env/<agent>.env(.example) 에 둡니다 — 중복 금지.

# 서버 레벨 설정 (모든 tool에 공통)
APP_ENV=dev

# 서버 실행 설정 (dev)
SERVER_HOST=0.0.0.0
SERVER_PORT=9101

# 공통 LLM 생성 파라미터 (Cohere/OpenAI 공용)
TEMPERATURE=0.0
TIMEOUT=120
TOP_K=1
MAX_TOKENS=2048
# 추론(thinking/reasoning) 기본 OFF — 원할 때만 켠다.
THINKING=false

# Cohere 내부 LLM 엔드포인트 (Cohere SDK, API 키 불필요)
# 사용법: model_id 에 cohere:<별칭> 지정 — 예) cohere:north-large
#   별칭 = base_url 선택 키이자 chat(model=별칭) 인자.
#   새 엔드포인트는 COHERE_ENDPOINT_<별칭>=<base_url> 한 줄 추가만으로 사용 가능.
COHERE_ENDPOINT_ZIPHYUN=http://your-ziphyun-endpoint       # 예) http://172.20.22.198
COHERE_ENDPOINT_NORTH_LARGE=http://your-north-large-endpoint  # 예) http://172.20.22.199
# 기본 Cohere 모델 = 위 별칭 중 하나 (OPENAI_MODEL 과 동일한 역할).
# model_id를 'cohere'(provider만)로 지정할 때 chat(model=별칭)으로 사용됨.
COHERE_MODEL=north-large

# OpenAI 설정 (openai:* 모델 / 임베딩 사용 시)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# (선택) reasoning 모델 추론 강도 — 기본 빈값=OFF. 허용: minimal|low|medium|high
OPENAI_REASONING_EFFORT=

# 임베딩 설정 (LLMManager.aembed — SQL Explorer KB 의미검색 등에서 사용)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# 주의 (글로벌 ↔ 에이전트 분리 규칙):
# - 에이전트 전용 키는 src/agents/agent_env/<agent>.env 에 둡니다. 예:
#     · nl2sql:  NL2SQL_DB_*, NL2SQL_OPENSEARCH_*, NL2SQL_EMBEDDING_*
#     · dart_search: DART_API_KEY 등 / web_search: TAVILY_API_KEY, PERPLEXITY_API_KEY
#     · chart_generator: MCP_SERVER_URL, CHART_GENERATOR_* 등
# - 에이전트 env에서는 "어떤 모델을 쓸지"(*_MODEL_ID)만 고르고,
#   LLM API 키/엔드포인트는 이 루트 .env 에서만 관리합니다.
