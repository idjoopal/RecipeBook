# Cookbook MCP — agent-level environment variables
#
# 글로벌 .env 와 분리해서 cookbook 도구만 영향을 받게 합니다.
# 실제 운영 시 cookbook.env 로 복사해 값 조정.

# 콘텐츠 디렉토리 (main.py 기준 상대 경로)
COOKBOOK_CONTENT_DIR=cookbook

# 토크나이저: "fallback" (기본 whitespace+lowercase) | "kiwi" (kiwipiepy 형태소)
# kiwi 사용 시 [project.optional-dependencies] korean 으로 kiwipiepy 설치 필요
COOKBOOK_TOKENIZER=fallback

# Hot reload 모드: "auto" (watchdog 우선, 폴백 polling) | "poll" (강제 polling)
COOKBOOK_WATCH_MODE=auto
